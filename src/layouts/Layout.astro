---
import "../styles/app.css";
import Frame from "../components/frame.astro";

const base = import.meta.env.BASE_URL;
const site = "https://SwannSchilling.github.io/team-calendar";
const title = "Team Calendar — the studio scheduler that retires the sheet, the chat, and the napkin";
const description = "A feature tour of Team Calendar, the tattoo-studio management PWA: guided booking, per-chair scheduling, a commission ledger, client reviews and an offline PWA. 81 features, 11 work areas, filterable inventory.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0b09" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Team Calendar" />
    <meta property="og:title" content="Team Calendar — one app retires the sheet, the chat, and the napkin" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site}/`} />
    <link rel="canonical" href={`${site}/`} />
    <meta name="author" content="Swann Schilling" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Team Calendar — the studio scheduler" />
    <meta name="twitter:description" content={description} />
  </head>
  <body id="top">
    <Frame />
    <div class="page">
      <main class="content__wrapper">
        <slot />
      </main>
    </div>
    <script src="../scripts/app.js"></script>
  </body>
</html>
