---
import type { MockCopy } from '../data/tour';

interface Props {
  compact?: boolean;
  copy: MockCopy['phone'];
}

const { compact = false, copy } = Astro.props;
---

<figure class={`mock phone-mock-wrap ${compact ? 'is-compact' : ''}`} aria-label={copy.aria} style="padding:0">
  <div class="phone-mock">
    <div class="phone-mock__notch"></div>
    <div class="phone-mock__homescreen">
      <div class="phone-mock__app">
        <span class="phone-mock__icon phone-mock__icon--main">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="5" width="18" height="16" rx="2.5" stroke="#0c0b09" stroke-width="2" />
            <path d="M3 10h18" stroke="#0c0b09" stroke-width="2" />
            <path d="M8 3v4M16 3v4" stroke="#0c0b09" stroke-width="2" stroke-linecap="round" />
            <rect x="7" y="13" width="5" height="4" rx="1" fill="#0c0b09" />
          </svg>
        </span>
        <span class="phone-mock__badge">3</span>
        <span class="phone-mock__appname">{copy.app}</span>
      </div>
      {Array.from({ length: compact ? 3 : 7 }, () => <span class="phone-mock__app"><span class="phone-mock__icon phone-mock__icon--dim"></span><span class="phone-mock__appname">&nbsp;</span></span>)}
    </div>
    <div class="phone-mock__notif">
      <div class="phone-mock__notiftitle"><span>{copy.n1t}</span><span>{copy.now}</span></div>
      <div class="phone-mock__notifbody">{copy.n1b}</div>
    </div>
    <div class="phone-mock__notif">
      <div class="phone-mock__notiftitle"><span>{copy.n2t}</span><span>{copy.ago}</span></div>
      <div class="phone-mock__notifbody">{copy.n2b}</div>
    </div>
    <div class="phone-mock__offline"><i></i>{copy.offline}</div>
  </div>
</figure>
