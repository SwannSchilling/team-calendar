---
import type { MockCopy } from '../data/tour';

interface Props {
  copy: MockCopy['ledger'];
}

const { copy } = Astro.props;
---

<figure class="mock ledger-mock" aria-label={copy.aria}>
  <div class="mock__bar">
    <span class="mock__dot"></span>
    <span class="mock__dot"></span>
    <span class="mock__title">{copy.title}</span>
    <span class="mock__pill">{copy.view}</span>
  </div>
  <div class="mock__body">
    {copy.jobs.map((job, i) => (
      <div class="ledger-mock__row">
        <div class="ledger-mock__job">{job.job} <small>{job.meta}</small></div>
        <div class="ledger-mock__split">
          <div class="ledger-mock__splitbar"><i class="a" style={`width:${[60, 55, 65][i]}%`}></i><i class="s" style={`width:${[40, 45, 35][i]}%`}></i></div>
          <div class="ledger-mock__splitlabel"><span>{copy.splitA} {[60, 55, 65][i]}%</span><span>{copy.splitB} {[40, 45, 35][i]}%</span></div>
        </div>
        <div class="ledger-mock__amt">{copy.amounts[i]}</div>
      </div>
    ))}
    <div class="ledger-mock__foot">
      <span class="ledger-mock__chip ledger-mock__chip--ok">{copy.ok}</span>
      <span class="ledger-mock__chip ledger-mock__chip--lock">{copy.lock}</span>
      <span class="ledger-mock__chip ledger-mock__chip--lock">{copy.print}</span>
    </div>
  </div>
</figure>
