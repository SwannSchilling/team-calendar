---
import { STATUS_LABELS } from '../utils/text';
import type { Locale } from '../utils/text';

interface Props {
  status: string[];
  locale?: Locale;
}

const { status, locale = 'en' } = Astro.props;
const labels = STATUS_LABELS[locale];
---

{status.map((s) => (
  <span class={`badge badge--${s}`}>{labels[s] ?? s}</span>
))}
