---
import type { MockCopy } from '../data/tour';

interface Props {
  compact?: boolean;
  copy: MockCopy['dayGrid'];
}

const { compact = false, copy } = Astro.props;

const chairs = [
  { name: copy.chairs[0], artist: copy.clients.alex },
  { name: copy.chairs[1], artist: copy.clients.sam },
  ...(compact ? [] : [{ name: copy.chairs[2], artist: copy.clients.lena }]),
];

// 8 hour columns; values: null | booked | timeoff | buffer
interface Cell {
  kind: 'empty' | 'booked' | 'timeoff' | 'buffer';
  name?: string;
  meta?: string;
  ref?: boolean;
}

function row(cells: (Cell | null)[]): Cell[] {
  return Array.from({ length: 8 }, (_, i) => cells[i] ?? { kind: 'empty' as const });
}

const data: Cell[][] = [
  row([null, null, { kind: 'booked', name: copy.clients.alex, meta: `14:00 · ${copy.services.custom}` }, { kind: 'booked', name: copy.clients.alex, meta: `15:00 · ${copy.services.custom}` }, { kind: 'buffer', meta: copy.buffer }, null, null, null]),
  row([{ kind: 'timeoff', meta: copy.timeoff }, null, null, null, { kind: 'booked', name: copy.clients.sam, meta: `18:00 · ${copy.services.flash}`, ref: true }, { kind: 'booked', name: copy.clients.sam, meta: `19:00 · ${copy.services.flash}`, ref: true }, null, null]),
  ...(compact ? [] : [row([null, { kind: 'booked', name: copy.clients.lena, meta: `11:00 · ${copy.services.coverup}` }, { kind: 'booked', name: copy.clients.lena, meta: `12:00 · ${copy.services.coverup}` }, { kind: 'buffer', meta: copy.buffer }, null, null, null, null])]),
];
---

<figure class={`mock grid-mock ${compact ? 'is-compact' : ''}`} aria-label={copy.aria}>
  <div class="mock__bar">
    <span class="mock__dot"></span>
    <span class="mock__dot"></span>
    <span class="mock__title">{copy.title}</span>
    <span class="mock__pill mock__pill--live">{copy.live}</span>
  </div>
  <div class="mock__body">
    <div class="grid-mock__head">
      <span></span>
      {Array.from({ length: 8 }, (_, i) => <span class="grid-mock__hcell">{String(9 + i).padStart(2, '0')}h</span>)}
    </div>
    {data.map((cells, i) => (
      <div class="grid-mock__row">
        <div class="grid-mock__chair">{chairs[i].name}<small>{chairs[i].artist}</small></div>
        {cells.map((c, j) => (
          c.kind === 'booked'
            ? <div class="grid-mock__cell grid-mock__cell--booked"><span class="grid-mock__name">{c.name}</span><span class="grid-mock__meta">{c.meta}{c.ref && <i class="grid-mock__ref" title={copy.refTitle}></i>}</span></div>
            : c.kind === 'timeoff'
              ? <div class="grid-mock__cell grid-mock__cell--timeoff">{c.meta}</div>
              : c.kind === 'buffer'
                ? <div class="grid-mock__cell grid-mock__cell--buffer">{c.meta}</div>
                : <div class="grid-mock__cell"></div>
        ))}
      </div>
    ))}
  </div>
</figure>
