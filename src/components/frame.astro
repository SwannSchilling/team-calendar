---
import type { UiStrings } from '../data/tour';
import type { Locale } from '../utils/text';

interface Props {
  locale: Locale;
  ui: UiStrings;
}

const { locale, ui } = Astro.props;
const base = import.meta.env.BASE_URL;
const hrefEn = base;
const hrefDe = `${base}de/`;
---

<header class="frame">
  <a class="frame__brand" href="#top">
    <svg class="frame__mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="2.5" y="4.5" width="19" height="17" rx="3" stroke="#f2a93b" stroke-width="2" />
      <path d="M2.5 9.5h19" stroke="#f2a93b" stroke-width="2" />
      <path d="M8 2.5v4M16 2.5v4" stroke="#f2a93b" stroke-width="2" stroke-linecap="round" />
      <rect x="6.5" y="12.5" width="6" height="4.5" rx="1" fill="#f2a93b" />
    </svg>
    <span class="frame__name">Team Calendar</span>
    <span class="frame__kind">{ui.frameKind}</span>
  </a>
  <nav class="frame__nav" aria-label="Sections">
    {ui.nav.map((l) => <a class="frame__link" data-spy={l.href.slice(1)} href={l.href}>{l.label}</a>)}
    <a class="frame__link frame__link--gh" href="https://github.com/SwannSchilling/team-calendar" target="blank" rel="noreferrer">{ui.github}</a>
    <div class="frame__lang" role="group" aria-label="Sprache / Language">
      <a class="frame__lang-btn" href={hrefEn} aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
      <span class="frame__lang-sep" aria-hidden="true">/</span>
      <a class="frame__lang-btn" href={hrefDe} aria-current={locale === 'de' ? 'page' : undefined}>DE</a>
    </div>
  </nav>
</header>
