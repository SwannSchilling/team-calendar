---
import type { MockCopy } from '../data/tour';

interface Props {
  copy: MockCopy['link'];
}

const { copy } = Astro.props;
---

<figure class="mock link-mock" aria-label={copy.aria} style="padding:0">
  <div class="mock__body" style="padding:1rem">
    <div class="link-mock__msg">
      <div class="link-mock__from">{copy.from}</div>
      <div class="link-mock__text">{copy.text}</div>
      <span class="link-mock__url">ink-haven.app/r/8f3a…&nbsp; <small>{copy.urlLabel}</small></span>
    </div>
  </div>
</figure>
