---
import type { MockCopy } from '../data/tour';

interface Props {
  copy: MockCopy['flow'];
}

const { copy } = Astro.props;
---

<figure class="mock flow-mock" aria-label={copy.aria}>
  <div class="mock__bar">
    <span class="mock__dot"></span>
    <span class="mock__dot"></span>
    <span class="mock__title">{copy.title}</span>
  </div>
  <div class="mock__body">
    <div class="flow-mock__steps">
      {copy.steps.map((s, i) => (
        <div class="flow-mock__step">
          <span class="flow-mock__n">{String(i + 1).padStart(2, '0')}</span>
          <span class="flow-mock__t">{s.t}</span>
          <span class="flow-mock__d">{s.d}</span>
        </div>
      ))}
    </div>
    <div class="flow-mock__foot"><i></i> {copy.foot}</div>
  </div>
</figure>
