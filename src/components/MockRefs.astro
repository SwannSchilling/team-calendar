---
import type { MockCopy } from '../data/tour';

interface Props {
  copy: MockCopy['refs'];
}

const { copy } = Astro.props;
---

<figure class="mock refs-mock" aria-label={copy.aria} style="padding:0">
  <div class="mock__body" style="padding:1rem">
    <div class="refs-mock__appt">
      <div class="refs-mock__apthead">
        <span class="refs-mock__apptname">{copy.appt}</span>
        <span class="mock__pill">{copy.pill}</span>
      </div>
      <div class="refs-mock__thumbs">
        <span class="refs-mock__thumb refs-mock__thumb--1"></span>
        <span class="refs-mock__thumb refs-mock__thumb--2"></span>
        <span class="refs-mock__thumb refs-mock__thumb--3">{copy.more}</span>
      </div>
      <div class="refs-mock__note">{copy.note}</div>
    </div>
  </div>
</figure>
