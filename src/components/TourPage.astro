---
import Layout from "../layouts/Layout.astro";
import type { Locale } from "../data/i18n";
import { getTour, getFeatures } from "../data/i18n";
import MockDayGrid from "./MockDayGrid.astro";
import MockLedger from "./MockLedger.astro";
import MockPhone from "./MockPhone.astro";
import MockFlow from "./MockFlow.astro";
import MockTenant from "./MockTenant.astro";
import MockMatrix from "./MockMatrix.astro";
import MockLink from "./MockLink.astro";
import MockRefs from "./MockRefs.astro";
import FeatureCard from "./FeatureCard.astro";
import StatusBadge from "./StatusBadge.astro";
import { plain, rolesFor } from "../utils/text";
import type { Feature } from "../types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tour = getTour(locale);
const featuresData = getFeatures(locale);
const { hero, storyIntro, storyBeats, pillarsIntro, pillars, differentIntro, differentPunch, inventoryIntro, legend, roadmap, honestyNote, footer, ui, mock } = tour;

const byId = new Map<number, Feature>();
for (const cat of featuresData.categories) for (const f of cat.features) byId.set(f.id, f);

const allRows = featuresData.categories.flatMap((c) => c.features.map((f) => ({ ...f, catId: c.id, catTitle: c.title })));
const total = featuresData.totalFeatures;
const countInit = ui.showing.replace('{n}', String(total)).replace('{total}', String(total));
---

<Layout locale={locale} meta={tour.meta} ui={tour.ui}>

<!-- ============ HERO ============ -->
<section class="hero" id="top">
  <div class="container hero__grid">
    <div>
      <p class="kicker">{hero.kicker}</p>
      <h1 class="hero__title">
        <span data-mtext style="display:block">{hero.titleA}</span>
        <span data-mtext class="accent" style="display:block">{hero.titleB}</span>
      </h1>
      <p class="hero__sub">{hero.sub}</p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href={hero.ctaPrimary.href}>{hero.ctaPrimary.label} ↓</a>
        <a class="btn btn--ghost" href={hero.ctaSecondary.href}>{hero.ctaSecondary.label}</a>
      </div>
      <div class="hero__stats">
        {hero.stats.map((s) => (
          <div class="stat">
            <div class="stat__value"><em>{s.value}</em></div>
            <div class="stat__label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
    <div class="hero__visual">
      <MockDayGrid copy={mock.dayGrid} />
    </div>
  </div>
</section>

<!-- ============ STORY ============ -->
<section class="section" id="story">
  <div class="container">
    <div class="container--narrow" style="margin-inline:0">
      <p class="kicker" data-reveal>{storyIntro.kicker}</p>
      <h2 class="h2" data-reveal>{storyIntro.title}</h2>
      <p class="lede" data-reveal>{storyIntro.sub}</p>
    </div>
    <div class="beats">
      {storyBeats.map((beat, i) => (
        <article class="beat" data-reveal style={`--reveal-delay:${i * 0.08}s`}>
          <div class="beat__time">{beat.time}</div>
          <h3 class="beat__title">{beat.title}</h3>
          {beat.visual === "link" && <MockLink copy={mock.link} />}
          {beat.visual === "grid" && <MockDayGrid compact copy={mock.dayGrid} />}
          {beat.visual === "refs" && <MockRefs copy={mock.refs} />}
          {beat.visual === "ledger" && <MockLedger copy={mock.ledger} />}
          {beat.visual === "phone" && <MockPhone compact copy={mock.phone} />}
          <p class="beat__pain"><span class="beat__pain-label">{ui.beatBefore}</span>{beat.pain}</p>
          <p class="beat__fix"><span class="beat__fix-label">{ui.beatAfter}</span>{beat.fix}</p>
          <div class="beat__features">
            {beat.featureIds.map((id) => {
              const f = byId.get(id);
              return f ? <a class="chip" href={`#inventory-${f.id}`}>#{f.id} · {f.title.length > 34 ? f.title.slice(0, 34) + '\u2026' : f.title}</a> : null;
            })}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============ TOOLKIT (pillars) ============ -->
<section class="section" id="features" style="padding-top:3rem">
  <div class="container">
    <div style="margin-bottom:2.5rem">
      <p class="kicker" data-reveal>{pillarsIntro.kicker}</p>
      <h2 class="h2" data-reveal>{pillarsIntro.title}</h2>
      <p class="lede" data-reveal>{pillarsIntro.sub}</p>
    </div>
    {pillars.map((p, pi) => (
      <div class="pillar" data-reveal>
        <div>
          <div class="pillar__num">{p.num} · {p.kicker}</div>
          <h3 class="pillar__title">{p.title}</h3>
          <p class="pillar__intro">{p.intro}</p>
          <div class="cards">
            {p.featureIds.map((id) => {
              const f = byId.get(id);
              return f ? <FeatureCard feature={f} locale={locale} diffLabel={ui.differentiator} /> : null;
            })}
          </div>
        </div>
        <div class="pillar__visual">
          {p.visual === "flow" && <MockFlow copy={mock.flow} />}
          {p.visual === "grid" && <MockDayGrid copy={mock.dayGrid} />}
          {p.visual === "ledger" && <MockLedger copy={mock.ledger} />}
          {p.visual === "phone" && <MockPhone copy={mock.phone} />}
          {p.visual === "tenant" && <MockTenant copy={mock.tenant} />}
          {p.visual === "matrix" && <MockMatrix copy={mock.matrix} />}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ============ DIFFERENTIATORS ============ -->
<section class="section" id="different">
  <div class="container">
    <p class="kicker" data-reveal>{differentIntro.kicker}</p>
    <h2 class="h2" data-reveal>{differentIntro.title}</h2>
    <p class="lede" data-reveal>{differentIntro.sub}</p>
    <div class="diff-grid">
      {featuresData.differentiators.map((d, i) => (
        <button class="diff" data-reveal type="button" aria-expanded="false">
          <div class="diff__head">
            <span class="diff__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="diff__title">{d.title}</span>
          </div>
          <p class="diff__punch">{differentPunch[i + 1]}</p>
          <p class="diff__refs">{d.refs}</p>
          <div class="diff__detail">{plain(d.line)}</div>
        </button>
      ))}
    </div>
  </div>
</section>

<!-- ============ INVENTORY ============ -->
<section class="section inventory" id="inventory">
  <div class="container">
    <p class="kicker" data-reveal>{inventoryIntro.kicker}</p>
    <h2 class="h2" data-reveal>{inventoryIntro.title}</h2>
    <p class="lede" data-reveal>{inventoryIntro.sub}</p>

    <div class="inv-controls" data-reveal>
      <input class="inv-search" id="inv-search" type="search" placeholder={ui.searchPlaceholder} aria-label={ui.searchAria} />
      <select class="inv-select" id="inv-cat" aria-label={ui.catAria}>
        <option value="">{ui.allAreas}</option>
        {featuresData.categories.map((c) => <option value={c.id}>{c.title}</option>)}
      </select>
      <div class="inv-filters" role="group" aria-label={ui.statusAria}>
        {legend.map((l) => <button class="inv-filter" data-status={l.key} type="button" aria-pressed="false">{l.mark} {l.label}</button>)}
      </div>
      <div class="inv-filters" role="group" aria-label={ui.roleAria}>
        {ui.roles.map((r) => <button class="inv-filter" data-role={r.key} type="button" aria-pressed="false">{r.label}</button>)}
      </div>
      <div class="inv-count" id="inv-count" aria-live="polite">{countInit}</div>
    </div>

    <div class="inv-table" id="inv-table" data-reveal>
      {allRows.map((f) => (
        <>
          <div class="inv-row" id={`inventory-${f.id}`} data-cat={f.catId} data-status={f.status.join(' ')} data-roles={rolesFor(f).join(' ')} data-text={plain(f.title + ' ' + f.what + ' ' + f.why).toLowerCase()} role="button" tabindex="0" aria-expanded="false">
            <span class="inv-row__num">#{f.id}</span>
            <span class="inv-row__title">{f.title}{f.differentiator && <span class="diff-star" style="font-size:0.7rem">★</span>}</span>
            <span class="inv-row__status"><StatusBadge status={f.status} locale={locale} /></span>
            <span class="inv-row__why">{plain(f.why)}</span>
          </div>
          <div class="inv-row__detail">
            <div class="inv-detail__grid">
              <div>
                <div class="inv-detail__label">{ui.whatLabel}</div>
                <p class="inv-detail__text">{plain(f.what)}</p>
              </div>
              <div>
                <div class="inv-detail__label">{ui.whoLabel}</div>
                <p class="inv-detail__text">{f.for}{f.notes.length ? <br /> : null}{f.notes.map((n) => <span style="display:block">{n.key}: {plain(n.text)}</span>)}</p>
              </div>
            </div>
          </div>
        </>
      ))}
      <div class="inv-empty" id="inv-empty">{ui.empty}</div>
    </div>

    <div class="honesty" data-reveal>{honestyNote}</div>
  </div>
</section>

<!-- ============ ROADMAP ============ -->
<section class="section" id="roadmap">
  <div class="container">
    <p class="kicker" data-reveal>{roadmap.kicker}</p>
    <h2 class="h2" data-reveal>{roadmap.title}</h2>
    <p class="lede" data-reveal>{roadmap.sub}</p>
    <div class="roadmap__grid">
      <div class="roadmap__col" data-reveal>
        <h3>{ui.soonHead}</h3>
        <div class="roadmap__list">
          {roadmap.soon.map((r) => (
            r.id ? <a class="roadmap__item" href={`#inventory-${r.id}`}><small>⏳</small>{r.label}</a>
                  : <span class="roadmap__item"><small>⏳</small>{r.label}</span>
          ))}
        </div>
      </div>
      <div class="roadmap__col" data-reveal style="--reveal-delay:0.1s">
        <h3>{ui.laterHead}</h3>
        <div class="roadmap__list">
          {roadmap.later.map((r) => (
            r.id ? <a class="roadmap__item" href={`#inventory-${r.id}`}><small>⏳</small>{r.label}</a>
                  : <span class="roadmap__item"><small>⏳</small>{r.label}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ FOOTER ============ -->
<footer class="footer">
  <div class="container footer__grid">
    <div>
      <div class="footer__word">Team Calendar</div>
      <p class="footer__tag">{footer.tagline}</p>
    </div>
    <div class="footer__meta">
      <div><a href={footer.github} target="blank" rel="noreferrer">{ui.sourceRepo}</a></div>
      <div>{ui.inventoryMeta} {featuresData.compiled}</div>
      <div>{ui.builtWith}</div>
    </div>
  </div>
</footer>

</Layout>
