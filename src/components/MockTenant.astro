---
import type { MockCopy } from '../data/tour';

interface Props {
  copy: MockCopy['tenant'];
}

const { copy } = Astro.props;
const slugs = ['/ink-haven', '/north-side'];
---

<figure class="mock tenant-mock" aria-label={copy.aria}>
  <div class="mock__bar">
    <span class="mock__dot"></span>
    <span class="mock__dot"></span>
    <span class="mock__title">{copy.title}</span>
  </div>
  <div class="mock__body">
    <div class="tenant-mock__user">
      <span class="tenant-mock__avatar"></span>
      <div>
        <div class="tenant-mock__uname">{copy.user}</div>
        <div class="tenant-mock__umeta">{copy.userMeta}</div>
      </div>
      <span class="mock__pill" style="margin-left:auto">{copy.member}</span>
    </div>
    <div class="tenant-mock__lines">
      {copy.meta.map((lines, i) => (
        <div class="tenant-mock__studio">
          <div class="tenant-mock__slug">{slugs[i]}</div>
          <div class="tenant-mock__meta">{lines[0]}<br />{lines[1]}</div>
        </div>
      ))}
    </div>
    <div class="tenant-mock__lock">
      <i>🔒</i>
      {copy.lock}
    </div>
  </div>
</figure>
