---
import type { MockCopy } from '../data/tour';

interface Props {
  copy: MockCopy['matrix'];
}

const { copy } = Astro.props;
const cellClass = (c: string) => (c === '\u2713' ? 'yes' : c === '\u2014' ? 'no' : 'some');
---

<figure class="mock matrix-mock" aria-label={copy.aria}>
  <div class="mock__bar">
    <span class="mock__dot"></span>
    <span class="mock__dot"></span>
    <span class="mock__title">{copy.title}</span>
  </div>
  <div class="mock__body" style="padding:0.6rem 0.9rem">
    <table>
      <thead>
        <tr>
          <th></th>
          {copy.cols.map((c) => <th>{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {copy.rows.map((r) => (
          <tr>
            <td><strong style="color:var(--paper)">{r.role}</strong></td>
            {r.cells.map((c) => <td class={cellClass(c)}>{c}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</figure>
